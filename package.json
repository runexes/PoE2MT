{
  "name": "poe2mt-app",
  "version": "0.2.0",
  "description": "Electron desktop tracker for Path of Exile 2 map runs.",
  "license": "MIT",
  "author": "runexes (https://github.com/runexes)",
  "homepage": "https://github.com/runexes/PoE2MT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runexes/PoE2MT.git"
  },
  "bugs": {
    "url": "https://github.com/runexes/PoE2MT/issues"
  },
  "keywords": [
    "path-of-exile",
    "path-of-exile-2",
    "poe2",
    "electron",
    "tracker",
    "overlay",
    "client.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --target=es2022 --outfile=src/bundle.js",
    "build:watch": "npm run build -- --watch",
    "serve": "node scripts/serve.js",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "lint": "eslint src electron",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "build": {
    "appId": "com.poe2mt.app",
    "productName": "PoE2 Map Tracker",
    "files": [
      "electron/**/*",
      "i18n/**/*",
      "src/index.html",
      "src/styles.css",
      "src/favicon.ico",
      "src/bundle.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "poe2mt.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "poe2mt.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
