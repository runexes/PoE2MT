{
  "name": "poe2mt-app",
  "version": "0.1.0",
  "description": "PoE 2 Map Tracker App",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --target=es2022 --outfile=src/bundle.js",
    "build:watch": "npm run build -- --watch",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "lint": "eslint src electron",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "build": {
    "appId": "com.poe2mt.app",
    "productName": "PoE2 Map Tracker",
    "files": [
      "electron/**/*",
      "i18n/**/*",
      "src/index.html",
      "src/styles.css",
      "src/favicon.ico",
      "src/bundle.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "poe2mt.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "artifactName": "poe2mt.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
